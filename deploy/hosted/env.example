# Copy to .env in this folder (cp env.example .env) and fill in. Docker Compose reads .env by
# itself, so every command here is a plain `docker compose ...`. docs/hosting.md has the rest.

# The address the family opens; its DNS must point at this server.
DEN_DOMAIN=den.example.com

# What runs next to the hub:
#   caddy        Caddy answers on ports 80 and 443 and gets the certificate itself (setup A)
#   tunnel       a Cloudflare Tunnel instead, with TUNNEL_TOKEN below (setup B)
#   (nothing)    the hub only, on this server's 127.0.0.1:47733, for Tailscale (setup C)
# Add ",model" for a model on the server that the hub reads with (caddy,model).
COMPOSE_PROFILES=caddy

# Setup B: the token of your Cloudflare Tunnel.
# TUNNEL_TOKEN=

# Backups (docker compose run --rm backup) are sealed with DEN_BACKUP_PASSPHRASE; add it with
#   echo "DEN_BACKUP_PASSPHRASE=$(openssl rand -base64 24)" >> .env
# and keep a copy in your password manager: a backup doesn't open without it.
# DEN_BACKUP_KEEP=14

# Unset, the hub is built from this checkout (docker compose up -d --build). To run a published
# release instead (after docker login ghcr.io), name it and use docker compose up -d:
# DEN_IMAGE=ghcr.io/xattribution/den-hub:v1.0.0

# What the hub is called in the Den app.
DEN_NAME=Den hub

# The port the hub listens on inside its container and on this server's 127.0.0.1.
# DEN_PORT=47733
