# Copy to deploy/hosted/.env and fill in. Docker Compose reads it on its own.

# The address the family opens; its DNS must point at this server.
DEN_DOMAIN=den.example.com

# What the hub is called in the Den app before it joins a family.
DEN_NAME=Den hub

# The port the hub listens on inside its container (and on this machine's 127.0.0.1).
# DEN_PORT=47733
