# Copy to .env in this folder for two families on one server (cp env.two-families.example .env)
# and fill in. Both domains' DNS must point at this server.
COMPOSE_FILE=two-families.yaml

FAMILY_A_DOMAIN=den.example.com
FAMILY_A_NAME=Den hub
FAMILY_B_DOMAIN=den-sister.example.com
FAMILY_B_NAME=Den hub

# Backups (docker compose run --rm backup-a, backup-b) are sealed with DEN_BACKUP_PASSPHRASE:
#   echo "DEN_BACKUP_PASSPHRASE=$(openssl rand -base64 24)" >> .env
# DEN_BACKUP_KEEP=14

# Unset, the hubs are built from this checkout. A published release instead:
# DEN_IMAGE=ghcr.io/xattribution/den-hub:v1.0.0
