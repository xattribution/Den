# The private setup's settings (docs/hosting.md, "Private: home networks plus Tailscale").
# install.sh copies this to .env and asks for what's missing; edit .env by hand any time after.
# Docker Compose reads .env by itself, and so does den-allowlist (through /etc/den/env).
# It holds a token and a passphrase: keep it readable by root only (chmod 600 .env).

# The one address the family opens, at home and away, on a domain whose DNS is on Cloudflare.
# Public DNS: an A (and AAAA) record for it with this server's public address, DNS only.
DEN_DOMAIN=den.example.com

# A Cloudflare API token for the certificate (the ACME DNS-01 challenge), made under My Profile,
# API Tokens, Create Custom Token, with two permissions, Zone / Zone / Read and Zone / DNS / Edit,
# and Zone Resources: Include, Specific zone, your domain. Nothing else.
CLOUDFLARE_API_TOKEN=

# The family's homes: each home's DDNS name, kept up to date with the home's public address, on
# Cloudflare as DNS only (grey cloud). Separated by spaces. den-allowlist looks them up every
# 3 minutes and lets those addresses reach HTTPS (443).
DEN_HOMES=home-one.example.com home-two.example.com

# How much of a home's IPv6 address to let in. Each device at home has its own IPv6 address in
# the home's /64, so 64 lets in the whole home; see docs/hosting.md if a home's IPv6 doesn't match.
# DEN_HOME_V6_PREFIX=64

# Fixed addresses or networks also allowed on 443, separated by spaces: a home with a static
# address and no DDNS name.
# DEN_ALLOW_EXTRA=

# SSH. By default only over Tailscale (from the admins in tailscale-acl.hujson). The VPS
# provider's web console is the way back in if that ever fails.
#   DEN_SSH_FROM_HOMES=1     also from the homes in DEN_HOMES
#   DEN_SSH_ALLOW=<address>  also from these addresses or networks; install.sh adds the address
#                            you install from here, until SSH over Tailscale works for you
DEN_SSH_FROM_HOMES=0
# DEN_SSH_ALLOW=

# Backups (docker compose run --rm backup) are sealed with this; install.sh makes one. Keep a
# copy in your password manager: a backup doesn't open without it.
DEN_BACKUP_PASSPHRASE=
# DEN_BACKUP_KEEP=14

# What the hub is called in the Den app.
DEN_NAME=Den hub

# Unset, the hub is built from this checkout. To run a published release instead (after
# docker login ghcr.io), name it here:
# DEN_IMAGE=ghcr.io/xattribution/den-hub:v1.0.0

# The port the hub listens on, on this server's 127.0.0.1 only.
# DEN_PORT=47733

# Other families on this server, a line each: the address, where its hub runs (host: one more
# family on the Den host, the hub above; a port: a hub container of its own), the homes' DDNS
# names. sudo ./install.sh add-family and remove-family write them, and merge-families turns
# ports into host (docs/hosting.md, "Several families"); while there are any, install.sh also sets
# COMPOSE_FILE, so docker compose reads compose.families.yaml too. Like:
# DEN_FAMILY_SMITH=den-smith.example.com host home.smith.example.net
