# Caddy in front of the family's hub, private setup (docs/hosting.md, "Private: home networks
# plus Tailscale"). It runs on the server's own network and listens on TCP 443 only: no port 80,
# no HTTP/3, no admin API. The firewall decides who reaches 443 at all (the homes and Tailscale);
# the hub's own device sign-in decides what they can do.
{
	admin off
	# Nothing listens on port 80, so there's nothing to redirect from.
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

{$DEN_DOMAIN} {
	# The certificate comes from Let's Encrypt through Cloudflare's DNS (the ACME DNS-01
	# challenge), with the token from .env. Caddy renews it the same way, about a month ahead.
	# 1.1.1.1 checks the challenge record, not the server's own resolver.
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	# Caddy sends X-Forwarded-For, -Proto and -Host, passes WebSockets (/ws) through, and
	# flushes the event stream as it comes; the hub sets its own security headers.
	@compressible not path /api/v1/stream
	encode @compressible zstd gzip
	reverse_proxy 127.0.0.1:{$DEN_PORT:47733}
}
